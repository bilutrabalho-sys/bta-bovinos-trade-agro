# Conexão com o PostgreSQL do BTA.
# Local (dev): banco "bta" no Postgres da sua máquina, usuário dono/superuser.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bta

# Porta do servidor HTTP.
PORT=3001

# --- Nuvem -----------------------------------------------------------------
# Para apontar para um Postgres gerenciado (Supabase, Neon, RDS, Railway...),
# basta trocar a DATABASE_URL. A maioria exige SSL — acrescente ?sslmode=require
# ao final. Ex.:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
