# Conexão com o PostgreSQL do BTA.
# Local (dev): banco "bta" no Postgres da sua máquina, usuário dono/superuser.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bta

# Porta do servidor HTTP.
PORT=3001

# Origens permitidas de CORS em PRODUÇÃO (lista separada por vírgula).
# - Se DEIXAR EM BRANCO / não definir: CORS liberado (qualquer origem) — ótimo
#   para dev, o Vite em localhost:5173 funciona sem configurar nada.
# - Em produção, preencha com as origens reais do app para travar o CORS. Ex.:
# ALLOWED_ORIGINS=https://app.bta.com.br,https://www.bta.com.br

# --- Nuvem -----------------------------------------------------------------
# Para apontar para um Postgres gerenciado (Neon, Supabase, RDS, Railway...),
# basta trocar a DATABASE_URL. A maioria exige SSL — acrescente ?sslmode=require
# ao final (o Neon já inclui isso na string que ele te dá). Ex.:
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
