# Fonte de dados do app BTA.
# 'mock' (padrao): usa os dados ficticios locais de src/data/mock.ts. O app roda
#                  sozinho, sem backend. Este e o comportamento padrao mesmo sem .env.
# 'api'          : consome o backend HTTP real (rotas sob /api de VITE_API_URL).
VITE_DATA_SOURCE=mock

# Base do backend usada no modo 'api'. Ignorado no modo 'mock'.
VITE_API_URL=http://localhost:3001
